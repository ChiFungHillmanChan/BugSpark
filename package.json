{
  "name": "bugspark",
  "private": true,
  "version": "0.1.0",
  "description": "Universal embeddable bug reporting SDK with admin dashboard",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:api": "cd packages/api && uvicorn app.main:app --reload --port 8000",
    "dev:dashboard": "cd packages/dashboard && pnpm dev",
    "dev:widget": "cd packages/widget && pnpm dev",
    "db:migrate": "cd packages/api && alembic upgrade head",
    "db:seed": "cd packages/api && python scripts/seed.py",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "cli:link": "cd packages/cli && pnpm build && npm link"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "next>sharp": "^0.35.5",
      "next>postcss": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "lodash@<4.18.0": "^4.18.1",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "terser-webpack-plugin@<5.5.0": "^5.5.0",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "@babel/core@<7.29.6": "^7.29.6"
    }
  }
}
